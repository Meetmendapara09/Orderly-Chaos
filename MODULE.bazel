"""Orderly Chaos: a price-time priority limit order book (matching engine)."""

module(
    name = "orderly_chaos",
    version = "0.2.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "0.0.11")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# GoogleTest is a test-only dependency, pinned by checksum for hermetic builds.
http_archive(
    name = "com_google_googletest",
    urls = ["https://github.com/google/googletest/archive/refs/tags/v1.14.0.tar.gz"],
    strip_prefix = "googletest-1.14.0",
    sha256 = "8ad598c73ad796e0d8280b082cebd82a630d73e73cd3c70057938a6501bba5d7",
    build_file = "//third_party/googletest:googletest.BUILD",
)

# MinGW-w64 toolchain for Windows (see toolchain/BUILD.bazel). It only
# matches Windows hosts, so Linux and macOS use their default toolchains.
register_toolchains("//toolchain:strawberry_mingw_toolchain")
