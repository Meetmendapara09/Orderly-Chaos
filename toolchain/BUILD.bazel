load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load("@rules_cc//cc/private/toolchain:windows_cc_toolchain_config.bzl", "cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

filegroup(name = "empty")

# MinGW runtime DLLs required by binaries produced with Strawberry g++
filegroup(
    name = "mingw_runtime",
    srcs = glob(["runtime/*.dll"]),
)

STRAWBERRY_BIN = "D:/Strawberry/c/bin"

cc_toolchain_config(
    name = "strawberry_mingw_config",
    cpu = "x64_windows",
    compiler = "mingw-gcc",
    toolchain_identifier = "strawberry_mingw_x64",
    host_system_name = "local",
    target_system_name = "x86_64-w64-mingw32",
    target_libc = "mingw",
    abi_version = "local",
    abi_libc_version = "local",
    tool_bin_path = STRAWBERRY_BIN,
    tool_paths = {
        "ar": STRAWBERRY_BIN + "/ar.exe",
        "cpp": STRAWBERRY_BIN + "/cpp.exe",
        "gcc": STRAWBERRY_BIN + "/g++.exe",
        "gcov": STRAWBERRY_BIN + "/gcov.exe",
        "ld": STRAWBERRY_BIN + "/ld.exe",
        "nm": STRAWBERRY_BIN + "/nm.exe",
        "objcopy": STRAWBERRY_BIN + "/objcopy.exe",
        "objdump": STRAWBERRY_BIN + "/objdump.exe",
        "strip": STRAWBERRY_BIN + "/strip.exe",
    },
    cxx_builtin_include_directories = [
        "D:/Strawberry/c/include/c++/13.2.0",
        "D:/Strawberry/c/include/c++/13.2.0/x86_64-w64-mingw32",
        "D:/Strawberry/c/include/c++/13.2.0/backward",
        "D:/Strawberry/c/lib/gcc/x86_64-w64-mingw32/13.2.0/include",
        "D:/Strawberry/c/include",
        "D:/Strawberry/c/lib/gcc/x86_64-w64-mingw32/13.2.0/include-fixed",
        "D:/Strawberry/c/x86_64-w64-mingw32/include",
    ],
)

cc_toolchain(
    name = "strawberry_mingw",
    toolchain_config = ":strawberry_mingw_config",
    all_files = ":empty",
    ar_files = ":empty",
    as_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 0,
)

toolchain(
    name = "strawberry_mingw_toolchain",
    exec_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":strawberry_mingw",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)
