# Keep the Docker build context to source files only.
.git/
.github/
.gitignore
build/
dist/
*.egg-info/
**/*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.coverage*
htmlcov/
node_modules/
package.json
package-lock.json
bazel-bin
bazel-out
bazel-testlogs
bazel-*
user.bazelrc
.venv/
venv/
docs/
benchmarks/
toolchain/
Doxyfile
