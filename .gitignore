# MARK: Project Files

# Build output (setup.py, ad-hoc build dirs)
build*/

# Orderly Chaos build artifacts. The shared library staged next to the
# Python package (python/orderly_chaos/lib_orderly_chaos.*) is built by
# `make python-lib` or `pip install` and is never committed.
_orderly_chaos.so
_orderly_chaos.dll
lib_orderly_chaos.a
python/orderly_chaos/lib_orderly_chaos*.so
python/orderly_chaos/lib_orderly_chaos*.dylib
python/orderly_chaos/lib_orderly_chaos*.dll
python/orderly_chaos/lib_orderly_chaos*.pyd
python/orderly_chaos/*.so
python/orderly_chaos/*.pyd

# Test frameworks are fetched via Bzlmod, not vendored
gtest.tar.gz

# Local tooling (not part of the project)
node_modules/
/package.json
/package-lock.json
.kilo/
.agents/
skills-lock.json



# MARK: Bazel Files
# .bazelrc and .bazelignore are shared and committed; put machine-specific
# options (BAZEL_SH, MinGW paths, caches) in user.bazelrc instead.

/bazel-*
user.bazelrc
.bazelproject
.ijwb/
.clwb/



